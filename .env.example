# Live LLM mode. Set to 1 to use real providers (any key below); unset/0 = free mock.
AI_TOWN_LIVE=1

# Provider keys (all free-tier, no card). Any subset works; chains adapt:
#   Groq      -> https://console.groq.com/keys       (llama-3.1-8b / llama-3.3-70b)
#   Gemini    -> https://aistudio.google.com/apikey  (gemini-2.5-flash)
#   OpenRouter-> https://openrouter.ai/keys          (third free fallback; English + structured only)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional: override the free OpenRouter model (default meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_MODEL=

# Language of the generated free text (dialogue lines, reflections, gossip).
# Structured fields/actions always stay English. Default en. Example: zh-TW.
AI_TOWN_LANG=zh-TW

# Live-mode dialogue budget per simulated day (keeps free-tier token spend bounded).
# Default 12. Structured/behaviour are unaffected; agents just chat less once spent.
AI_TOWN_DIALOGUE_CAP=12

# Spend cap (USD). The router collapses to the free mock provider once reached,
# so a runaway loop can never burn the budget. <=0 disables the cap. Default 1.0.
AI_TOWN_BUDGET_USD=1.0

# Optional: persistence (PostgreSQL + pgvector); leave empty for in-memory.
AI_TOWN_DB_URL=postgresql+asyncpg://aitown:aitown@localhost:5432/aitown

# Optional: pin a Chinese-capable free OpenRouter model for the zh dialogue/reflection
# chain tail (before mock). Defaults to Gemma 4 26B; blank to disable. Free list churns —
# re-check GET https://openrouter.ai/api/v1/models when zh output degrades.
# OPENROUTER_MODEL_ZH=google/gemma-4-26b-a4b-it:free

# Optional: keep simulating with no viewers (records history for replay). Default 0.
# AI_TOWN_UNATTENDED=1
# Cruise speed (sim-min per real second) while no one is watching. Default 2.
# AI_TOWN_UNATTENDED_SPEED=2